{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical RFQ",
  "type": "object",
  "required": ["material", "quantity", "process"],
  "properties": {
    "rfq_id": {"type": "string"},
    "context_id": {"type": "string", "pattern": "^RFQ-"},
    "customer_id": {"type": "string"},
    "material": {"type": ["string", "null"], "description": "归一化材料: 6061/7075/304/316L/TC4/45钢/Q235/黄铜"},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "process": {"type": "string", "default": "CNC"},
    "dimensions_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "tolerance_grade": {"type": ["string", "null"], "enum": [null, "IT4", "IT5", "IT6", "IT7", "IT8", "IT9", "IT10"]},
    "tolerance_mm": {"type": ["number", "null"]},
    "surface": {"type": ["string", "null"], "description": "归一化表面处理"},
    "weight_kg": {"type": ["number", "null"]},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "object"}}
  }
}
