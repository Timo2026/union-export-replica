{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Union Context Object",
  "type": "object",
  "required": ["context_id", "state"],
  "properties": {
    "context_id": {"type": "string", "pattern": "^RFQ-"},
    "state": {"type": "string", "enum": ["NEW", "INTAKE", "STRUCTURING", "DFM", "QUOTING", "VERIFY", "HITL", "HUMAN_APPROVAL", "REPLY", "CRM_MEM", "DONE", "BLOCKED", "ARCHIVED"]},
    "customer": {"type": "object"},
    "rfq": {"type": "object"},
    "geometry": {"type": "object"},
    "manufacturing": {"type": "object", "properties": {"dfm": {"type": "object"}}},
    "commercial": {"type": "object", "properties": {"quote": {"type": "object"}, "margin_pct": {"type": ["number", "null"]}}},
    "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}},
    "risk": {"type": "object", "properties": {"multimodal_conflicts": {"type": "array"}}},
    "decision": {"type": "object", "properties": {"status": {"type": "string", "enum": ["PASS", "HITL", "BLOCKED"]}}},
    "events": {"type": "array"}
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_type", "checksum"],
      "properties": {
        "evidence_id": {"type": "string"},
        "source_type": {"type": "string", "enum": ["email", "pdf", "step", "audio", "video", "crm", "rag"]},
        "source_ref": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "checksum": {"type": "string", "pattern": "^sha256:"},
        "mock": {"type": "boolean"}
      }
    }
  }
}
